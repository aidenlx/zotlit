{
  "name": "ort-infer-napi",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "napi build --platform --release -p ort_infer_napi --cargo-cwd . --manifest-path crates/ort_infer_napi/Cargo.toml",
    "build:debug": "napi build --platform -p ort_infer_napi --cargo-cwd . --manifest-path crates/ort_infer_napi/Cargo.toml"
  },
  "napi": {
    "binaryName": "ort_infer",
    "targets": ["x86_64-unknown-linux-gnu"]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9"
  },
  "type": "commonjs"
}
