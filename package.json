  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@zotlit/config": "workspace:*",
    "lefthook": "^2.1.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.9.18"
  },
  "packageManager": "pnpm@11.1.3"
}
