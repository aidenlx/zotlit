{
  "name": "zotlit",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/aidenlx/zotlit"
  },
  "type": "module",
  "scripts": {
    "release": "pnpm --filter @zotlit/scripts release",
    "build:plugin": "turbo run build --filter=@zotlit/obsidian --output-logs=full",
    "deploy:docs": "mise exec node@24 -- vercel deploy apps/docs",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run //#lint:repo",
    "lint:fix": "turbo run //#lint:repo -- --fix",
    "lint:repo": "oxlint",
    "review": "turbo run //#review:plugin",
    "review:plugin": "eslint",
    "review:fix": "eslint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "quality": "pnpm lint && pnpm format",
    "quality:fix": "pnpm lint:fix && pnpm format:fix",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "agent-browser": "^0.33.1"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "eslint": "^10.8.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "lefthook": "^2.1.1",
    "obsidian": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.10.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.1.3"
}
