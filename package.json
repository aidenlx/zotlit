{
  "name": "zotlit",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/aidenlx/zotlit"
  },
  "type": "module",
  "scripts": {
    "release": "pnpm --filter @zotlit/scripts release",
    "build": "turbo run build --output-logs=full",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run //#lint:repo",
    "lint:fix": "turbo run //#lint:repo -- --fix",
    "lint:repo": "oxlint",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "quality": "pnpm lint && pnpm format",
    "quality:fix": "pnpm lint:fix && pnpm format:fix",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "agent-browser": "^0.33.1"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@zotlit/config": "workspace:*",
    "lefthook": "^2.1.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.9.18"
  },
  "packageManager": "pnpm@11.1.3"
}
