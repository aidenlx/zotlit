[{% liquid
  assign cites = "" | split: ","
  for c in zt.citations
    if c.item.citationKey
      if c.suppressAuthor
        assign cite = "-@" | append: c.item.citationKey
      else
        assign cite = "@" | append: c.item.citationKey
      endif
      if c.locator
        assign cite = cite | append: ", " | append: c.labelShort | append: " " | append: c.locator
      endif
      assign cites = cites | push: cite
    endif
  endfor
  echo cites | join: "; "
%}]