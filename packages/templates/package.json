{
  "name": "@zotlit/templates",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "defaults"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./constants": "./dist/constants.mjs",
    "./facade": "./dist/facade.mjs",
    "./frontmatter": "./dist/frontmatter.mjs",
    "./frontmatter-merge": "./dist/frontmatter-merge.mjs",
    "./liquid": "./dist/liquid.mjs",
    "./obsidian": "./dist/obsidian.mjs",
    "./package.json": "./package.json",
    "./defaults/*.eta": "./defaults/*.eta",
    "./defaults/*.liquid": "./defaults/*.liquid"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsgo --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@zotlit/shared": "workspace:*",
    "arkregex": "catalog:",
    "eta": "catalog:",
    "liquidjs": "^10.27.1",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node-25": "npm:@types/node@^25.6.2",
    "@typescript/native-preview": "catalog:",
    "@zotlit/config": "workspace:*",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
