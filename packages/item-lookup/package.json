{
  "name": "@zotlit/item-lookup",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./fixtures": "./dist/fixtures.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsgo --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "tsgo --noEmit -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "@zotlit/db": "workspace:*",
    "@zotlit/shared": "workspace:*",
    "arkregex": "catalog:",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@types/node-25": "npm:@types/node@^25.6.2",
    "@typescript/native-preview": "catalog:",
    "@zotlit/config": "workspace:*",
    "jieba-wasm": "^2.4.0",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
