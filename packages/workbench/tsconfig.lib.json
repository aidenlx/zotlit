{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": [
      "ES2025",
      "DOM",
      "ESNext.Disposable",
      "ESNext.Error",
      "ESNext.Temporal",
      "ESNext.Date",
      "ESNext.Intl"
    ],
    "declaration": true,
    "declarationMap": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "src",
    "isolatedDeclarations": false,
    "types": []
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./dist/**/*", "./src/**/*.test.ts"]
}
