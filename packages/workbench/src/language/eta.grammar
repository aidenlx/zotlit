// Eta delimiter rules: quoted strings and block comments shield closing tags.
@top Template { (Text | Tag)* }

Tag { (TagOpen | TagOpenInterp | TagOpenRaw) TagContent TagClose }
TagContent { (String | BlockComment | content)* }

@tokens {
  TagOpenInterp { "<%" $[-_]? "=" }
  TagOpenRaw { "<%" $[-_]? "~" }
  TagOpen { "<%" $[-_]? }
  TagClose { $[-_]? "%>" }

  Text { ![<]+ | "<" }
  String {
    '"' (!["\\] | "\\" (_ | @eof))* ('"' | @eof) |
    "'" (!['\\] | "\\" (_ | @eof))* ("'" | @eof) |
    "`" (![\`\\] | "\\" (_ | @eof))* ("`" | @eof)
  }
  BlockComment { "/*" (![\*] | "*"+ ![*/])* "*"* ("*/" | @eof) }
  content { ![%\-_'"\`/]+ | $[%\-_/] }

  @precedence { TagOpenInterp, TagOpenRaw, TagOpen, Text }
  @precedence { TagClose, BlockComment, content }
}
