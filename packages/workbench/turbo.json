{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The `ui` subpath's Paraglide facade over the root catalog's
    // `workbench_*` namespace. Each consumer waits for this single writer.
    "generate:i18n": {
      "inputs": [
        "scripts/generate-i18n.ts",
        "$TURBO_ROOT$/packages/config/paraglide.ts",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ],
      "outputs": ["src/ui/paraglide/**"],
      "outputLogs": "errors-only"
    },
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate:i18n"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate:i18n"]
    },
    "typecheck:test": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate:i18n"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate:i18n"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ]
    }
  }
}
