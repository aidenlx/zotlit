{
  "name": "@zotlit/workbench",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./bridge": "./dist/bridge.mjs",
    "./document": "./dist/document.mjs",
    "./explorer": "./dist/explorer.mjs",
    "./language": "./dist/language.mjs",
    "./render": "./dist/render.mjs",
    "./snapshot": {
      "types": "./dist/snapshot.d.mts",
      "node": "./dist/snapshot.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@zotlit/db": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/zotero-types": "workspace:*",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:"
  }
}
