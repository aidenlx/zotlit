{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.obsidian"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "isolatedDeclarations": false,
    "types": ["node-24"],
    "paths": {
      "@/*": ["./src/*"],
      "@drizzle/*": ["./drizzle/*"]
    }
  },
  "include": ["./src/**/*.ts", "./drizzle/**/*.ts"],
  "exclude": ["./node_modules", "./dist/**/*", "./src/**/*.test.ts"]
}
