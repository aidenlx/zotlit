{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.chrome142"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node-22"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./dist/**/*"]
}
