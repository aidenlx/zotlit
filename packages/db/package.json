{
  "name": "@zotlit/db",
  "version": "0.0.0",
  "private": true,
  "description": "Zotero SQLite database layer for reading Zotero libraries",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#contract/*": "./src/contract/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./client/node": "./dist/client/node.mjs",
    "./client/web": "./dist/client/web.mjs",
    "./contract/ir": "./dist/contract/ir.mjs",
    "./path": "./dist/path.mjs",
    "./test-utils": "./dist/test-utils.mjs",
    "./package.json": "./package.json",
    "./contract/ir.json": "./src/contract/generated/ir.json"
  },
  "scripts": {
    "build": "tsdown",
    "db:pull": "drizzle-kit pull",
    "dev": "tsdown --watch",
    "generate:contract": "node scripts/generate-contract.ts && oxfmt src/contract/generated",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@logtape/logtape": "catalog:",
    "@std/collections": "catalog:",
    "@zotlit/shared": "workspace:*",
    "@zotlit/zotero-types": "workspace:*",
    "arkregex": "catalog:",
    "drizzle-orm": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node-22": "npm:@types/node@^22.9.0",
    "@types/node-25": "npm:@types/node@^25.6.2",
    "@zotlit/config": "workspace:*",
    "ajv": "^8.20.0",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "ts-morph": "^28.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "sqlocal": "^0.18.0"
  },
  "peerDependenciesMeta": {
    "sqlocal": {
      "optional": true
    }
  }
}
