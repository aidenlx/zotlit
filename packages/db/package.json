{
  "name": "@zotlit/db",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./schema": "./dist/schema.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "db:pull": "drizzle-kit pull",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsgo --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "tsgo --noEmit -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "@zotlit/shared": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node-22": "npm:@types/node@^22.9.0",
    "@types/node-25": "npm:@types/node@^25.6.2",
    "@typescript/native-preview": "catalog:",
    "@zotlit/config": "workspace:*",
    "drizzle-kit": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
