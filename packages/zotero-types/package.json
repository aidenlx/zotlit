{
  "name": "@zotlit/zotero-types",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/fields.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "generate:fields": "node scripts/generate-fields.ts && oxlint --fix && oxfmt",
    "typecheck": "tsgo --noEmit -p tsconfig.lib.json && tsgo --noEmit -p tsconfig.node.json",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@types/node-25": "npm:@types/node@^25.6.2",
    "@typescript/native-preview": "catalog:",
    "@zotlit/config": "workspace:*",
    "oxlint": "catalog:",
    "tsdown": "catalog:"
  }
}
