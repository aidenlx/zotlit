{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.node26"],
  "compilerOptions": {
    "isolatedDeclarations": false,
    // Read by the effecttsgo lint rules. The Fixture's Local Bridge test
    // drives the client over Effect's HTTP client on purpose.
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["effect/http"]
      }
    ],
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["./lib/**/*.ts", "./scripts/**/*.ts"],
  "exclude": ["./node_modules"]
}
