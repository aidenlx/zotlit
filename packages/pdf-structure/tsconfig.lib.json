{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025"],
    "declaration": true,
    "declarationMap": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "isolatedDeclarations": false,
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "@oracle/*": ["./oracle/*"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules", "./dist/**/*", "./src/**/*.test.ts"]
}
