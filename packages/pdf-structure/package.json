{
  "name": "@zotlit/pdf-structure",
  "version": "0.0.0",
  "private": true,
  "description": "Pinned port of Zotero's PDF text structure, with the Sort Index and Page Label it computes",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@logtape/logtape": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "@zotlit/scripts": "workspace:*",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
