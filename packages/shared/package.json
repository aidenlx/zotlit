{
  "name": "@zotlit/shared",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./delimited": "./dist/delimited.mjs",
    "./log-formatter": "./dist/log-formatter.mjs",
    "./logging": "./dist/logging.mjs",
    "./nanoevents": "./dist/nanoevents.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zotlit/config": "workspace:*",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@logtape/logtape": ">=2.0.0"
  }
}
