{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.node26"],
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    "types": ["node-25"]
  },
  "include": [
    "./scripts/**/*.ts",
    "./src/constant.ts",
    "vite.config.ts",
    "vite.serve.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["./node_modules"]
}
