{
  "name": "@zotlit/zotero",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Zotero companion plugin for ZotLit — exports literature notes and annotations to Obsidian.",
  "author": "AidenLx",
  "type": "module",
  "scripts": {
    "build": "vite build && pnpm typecheck",
    "build:dev": "vite build --mode development",
    "dev": "vite build --watch --mode development --config vite.serve.config.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.app.json",
    "test": "tsgo --noEmit -p tsconfig.node.json && vitest run",
    "lint": "oxlint"
  },
  "dependencies": {
    "@logtape/logtape": "catalog:",
    "@std/async": "jsr:^1.3.0",
    "@zotlit/protocol": "workspace:*",
    "@zotlit/shared": "workspace:*",
    "core-js": "^3.39.0"
  },
  "devDependencies": {
    "@fluent/syntax": "^0.19.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node-25": "npm:@types/node@^25.6.2",
    "@types/semver": "^7.7.1",
    "@typescript/native-preview": "catalog:",
    "@zotlit/config": "workspace:*",
    "adm-zip": "^0.5.16",
    "oxc-parser": "^0.129.0",
    "oxlint": "catalog:",
    "semver": "^7.8.0",
    "tinyglobby": "^0.2.16",
    "valibot": "^1.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.13",
    "zotero-types": "4.1.2"
  },
  "zotero": {
    "id": "zotlit@aidenlx.top",
    "update_url": "https://raw.githubusercontent.com/aidenlx/zotlit/main/apps/zotero/update.json",
    "strict_min_version": "9.0",
    "strict_max_version": "9.*"
  }
}
