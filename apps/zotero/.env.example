# Copy to apps/zotero/.env and fill in.

# Path to the Zotero 9 binary.
#   macOS:   /Applications/Zotero.app/Contents/MacOS/zotero
#   Linux:   /opt/zotero/zotero
#   Windows: C:/Program Files/Zotero/zotero.exe
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=

# Optional. Path to an existing Zotero 9 dev profile dir.
# If unset, pnpm serve uses apps/zotero/.zotero-dev/profile.
# The runner applies the RDP prefs listed in apps/zotero/RDP_LAUNCH.md.
#   macOS:   ~/Zotero/Profiles/<random>.zotlit-dev
# ZOTERO_PLUGIN_PROFILE_PATH=

# Optional. If both this and ZOTERO_PLUGIN_PROFILE_PATH are unset, pnpm serve
# uses apps/zotero/.zotero-dev/data. If only profile path is set, Zotero uses
# that profile's normal data location.
# ZOTERO_PLUGIN_DATA_DIR=

# Optional. Set to false to suppress the --jsdebugger devtools window.
# ZOTERO_PLUGIN_DEVTOOLS=true
