{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zotlit-docs",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  // src/server.ts wraps the default TanStack Start entry with the Accept-header
  // negotiation and the asset hand-back.
  "main": "./src/server.ts",
  // The site answers on its own domain, so the workers.dev name is off and the
  // content has one host.
  "workers_dev": false,
  // A custom domain routes the whole hostname to this Worker and writes the DNS
  // record for it, so every path — assets included — arrives here.
  //
  // The route's fail-open setting is not part of this file; it is set once per
  // route in the Cloudflare dashboard. See the deployment section of AGENTS.md.
  "routes": [{ "pattern": "zotlit.aidenlx.site", "custom_domain": true }],
  "assets": {
    // The Worker hands a request back to the prerendered files through this
    // binding; see src/server.ts.
    "binding": "ASSETS",
    // Every canonical URL on this site is slash-free, and a prerendered page
    // lands at `<page>/index.html`; this mode serves it there instead of
    // redirecting the reader to a trailing slash.
    "html_handling": "drop-trailing-slash",
    // The HTML page paths, where the Accept header decides what the reader
    // gets. Every path outside the list — images, CSS, feeds, the redirect
    // table — is answered by the asset layer alone.
    //
    // A negative rule is a hand-off to the asset layer with no way back: a path
    // it names is answered by the assets and 404s when none matches, so the
    // Worker never sees it. The `.md` editions under these sections therefore
    // stay in, where a prerendered file still answers them without SSR and a
    // changelog version this build never published can still reach its
    // Pre-release Docs fallback. `/changelog/rss.xml` is negated because the
    // feed is always a file.
    "run_worker_first": [
      "/docs",
      "/docs/*",
      "/changelog",
      "/changelog/*",
      "/blog",
      "/blog/*",
      "!/changelog/rss.xml",
    ],
  },
  "vars": {
    // The production docs line. Pre-release Docs overrides this in `env.beta`,
    // so a changelog version missing from this build is handed on rather than
    // bounced back and forth.
    "DOCS_LINE": "production",
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"],
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    // Pre-release Docs: the beta line, deployed from `next`.
    "beta": {
      "name": "zotlit-docs-beta",
      "routes": [
        { "pattern": "zotlit-beta.aidenlx.site", "custom_domain": true },
      ],
      "vars": {
        "DOCS_LINE": "beta",
      },
      "secrets": {
        "required": ["GITHUB_TOKEN"],
      },
    },
  },
}
