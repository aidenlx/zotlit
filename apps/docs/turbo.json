{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The agent-skill archives are read from the repo-root `skills/` tree at
      // build time (src/lib/agent-skills.ts), so those files are build inputs.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ],
      "outputs": ["dist/**", ".tanstack/**", ".source/**"],
      // The Cloudflare Web Analytics site token is read at build time, so a
      // build with it differs from one without; `CLOUDFLARE_ENV` picks the
      // wrangler environment the build carries, so the beta build and the
      // production build are two different outputs.
      "env": ["VITE_CF_BEACON_TOKEN", "CLOUDFLARE_ENV", "GITHUB_SHA"]
    },
    // The `.source/` collection index, which the typecheck reads. `vite build`
    // regenerates it too, so a lint or typecheck run needs only this task.
    "codegen": {
      "outputs": [".source/**"],
      "outputLogs": "errors-only"
    },
    "generate:i18n": {
      "inputs": [
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ],
      "outputs": ["src/paraglide/**"],
      "outputLogs": "errors-only"
    },
    "cf-typegen:check": {
      "inputs": ["wrangler.jsonc", "worker-configuration.d.ts"],
      "outputLogs": "errors-only"
    },
    "generate:template-data": {
      "dependsOn": ["^build"],
      "outputs": ["content/docs/reference/templates/data.mdx"],
      "outputLogs": "errors-only"
    },
    // `src/http.test.ts` fetches the built Worker, so the build runs first.
    "test": {
      "dependsOn": ["^build", "transit", "build"]
    }
  }
}
