{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "codegen": {
      "outputs": [".source/**", ".next/types/**", "next-env.d.ts"],
      "outputLogs": "errors-only"
    },
    "generate:template-data": {
      "dependsOn": ["^build"],
      "outputs": ["content/docs/reference/templates/data.mdx"],
      "outputLogs": "errors-only"
    }
  }
}
