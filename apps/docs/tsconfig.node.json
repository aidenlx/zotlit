{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.node26"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedDeclarations": false,
    // The build renders the OG cards from JSX through takumi.
    "jsx": "react-jsx",
    // `vite.config.ts` runs the Template Directory module through Vite's
    // module runner, which resolves its `?raw` imports.
    "types": ["node", "vite/client"]
  },
  "include": [
    "./source.config.ts",
    "./content.config.ts",
    "./vite.config.ts",
    "./vitest.config.ts",
    "./oxlint.config.ts",
    "./oxfmt.config.ts",
    "./scripts/**/*.ts"
  ]
}
