{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "es2024",
    // `es2025.regexp` covers `RegExp.escape`, which policies/regex.md requires
    // for dynamic literal text.
    "lib": [
      "es2024",
      "es2025.regexp",
      "esnext.array",
      "esnext.disposable",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "noUncheckedSideEffectImports": true,
    "types": ["./worker-configuration.d.ts", "vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": ["./node_modules", "./dist", "./.tanstack"]
}
