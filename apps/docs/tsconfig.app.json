{
  "extends": ["@zotlit/config/tsconfig"],
  "compilerOptions": {
    "target": "es2024",
    // `es2025.regexp` covers `RegExp.escape`, which policies/regex.md requires
    // for dynamic literal text.
    "lib": [
      "es2024",
      "es2025.regexp",
      "esnext.array",
      "esnext.disposable",
      // The Workbench renders Managed Frontmatter against `Temporal`, which the
      // page polyfills when the runtime has none.
      // @see src/lib/workbench/temporal.ts
      "esnext.temporal",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Read by the effecttsgo lint rules. The Local Bridge client sends
    // through Effect's HTTP client on purpose.
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": ["effect/http"]
      }
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "noUncheckedSideEffectImports": true,
    "types": ["./worker-configuration.d.ts", "vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": ["./node_modules", "./dist", "./.tanstack"]
}
