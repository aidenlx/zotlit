exports[`zotlit:query formula answer text > keeps the answer text for a Formula that fields reads 1`] = `
"{
  "contractVersion": 3,
  "command": "zotlit:query",
  "ok": true,
  "identity": {
    "vault": {
      "name": "Research",
      "path": "/vaults/research"
    },
    "source": {
      "id": "source-1",
      "databasePath": "/zotero/zotero.sqlite"
    }
  },
  "libraries": [
    {
      "type": "personal"
    }
  ],
  "request": {
    "from": "items",
    "library": [
      "personal"
    ],
    "filter": "indexedKey == \\"BK2MNTH2\\"",
    "fields": [
      "title",
      "formula.year"
    ],
    "sort": [
      {
        "field": "dateModified",
        "direction": "desc"
      }
    ],
    "limit": 100,
    "formulas": {
      "year": "date.year",
      "unused": "title"
    }
  },
  "returnedCount": 1,
  "truncated": false,
  "warnings": [
    {
      "code": "unused-formula",
      "message": "The request defines formula.unused and reads it nowhere, so the query does not compute it.",
      "hint": "Add formula.unused to fields to get its value, or remove it from formulas.",
      "location": {
        "argument": "formulas",
        "path": "unused"
      },
      "severity": "warning",
      "report": [
        "The request defines formula.unused and reads it nowhere, so the query does not compute it.",
        "Add formula.unused to fields to get its value, or remove it from formulas."
      ],
      "found": "unused",
      "expected": [
        "formula.<name> in fields"
      ],
      "suggestions": []
    }
  ],
  "rows": [
    {
      "indexedKey": "BK2MNTH2",
      "values": {
        "title": "Methods for Everyone",
        "formula.year": 2019
      }
    }
  ]
}"
`;

