{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.chrome142"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedDeclarations": false,
    "types": ["node-22"],
    "paths": {
      "@/*": ["./src/*"],
      "@mock/*": ["./__mocks__/*"]
    }
  },
  "include": ["./src/**/*.ts", "./__mocks__/**/*.ts", "./vitest.config.ts"],
  "exclude": ["./node_modules", "./dist", "./dist-dev"]
}
