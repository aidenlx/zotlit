{
  "$schema": "https://www.schemastore.org/tsconfig",
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.obsidian"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // The rule tests in src/lint reach the Oxlint plugins, which Node loads
    // by their .ts paths.
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    // Read by the effecttsgo lint rules. Keep tsconfig.app.json and
    // tsconfig.test.json the same: each file takes the options of its tsconfig.
    "plugins": [
      {
        "name": "@effect/language-service",
        // effect-fn-opportunity names its fix Effect.fn("<Tag>.<method>").
        "effectFn": ["inferred-span"],
        // The worker RPC, the HTTP clients, the temp sweeps and the tests use
        // these on purpose.
        "allowedUnstableApis": [
          "@effect/platform-browser",
          "@effect/platform-node",
          "@effect/vitest",
          "effect/FileSystem",
          "effect/http",
          "effect/PlatformError",
          "effect/rpc",
          "effect/testing",
          "effect/workers"
        ]
      }
    ],
    "types": ["node-24"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@brand/*": ["../../assets/logo/*"],
      "@mock/*": ["./__mocks__/*"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.test.tsx", "./__mocks__/**/*.ts"],
  "exclude": ["./node_modules", "./dist", "./dist-dev"]
}
