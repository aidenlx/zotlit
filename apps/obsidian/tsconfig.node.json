{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.node26"],
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedDeclarations": false,
    // Read by the effecttsgo lint rules, as in tsconfig.app.json.
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": ["inferred-span"],
        "allowedUnstableApis": [
          "@effect/platform-browser",
          "@effect/platform-node",
          "@effect/vitest",
          "effect/http",
          "effect/rpc",
          "effect/testing",
          "effect/workers"
        ]
      }
    ],
    "types": ["node"]
  },
  "include": ["./scripts/**/*.js", "./scripts/**/*.ts", "vite.config.ts"],
  "exclude": ["./node_modules", "./src/**/*"]
}
