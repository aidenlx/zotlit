{
  "name": "@zotlit/obsidian",
  "version": "2.0.0-beta.4",
  "private": true,
  "description": "Plugin to integrate with Zotero, create literature notes and insert citations from a Zotero library.",
  "author": "AidenLx",
  "type": "module",
  "scripts": {
    "build": "vite build && npm run typecheck",
    "build:dev": "vite build --mode development",
    "generate:language-packs": "obsidian-i18n compile --project ../../project.inlang --output src/lib/i18n/generated --exclude-prefix docs_ --target-locale-prefix notice_language_pack_ --target-locale-prefix settings_language_pack_",
    "dev": "vite build --watch --mode development",
    "dev:i18n": "I18N_DEV_SERVER=true vite build --watch --mode development",
    "analyze": "ANALYZE=true vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@hono/node-server": "^2.0.10",
    "@hono/valibot-validator": "^0.6.1",
    "@std/async": "catalog:",
    "@std/collections": "catalog:",
    "@std/ini": "jsr:0.225.2",
    "@zotlit/db": "workspace:*",
    "@zotlit/item-lookup": "workspace:*",
    "@zotlit/obsidian-i18n": "workspace:*",
    "@zotlit/protocol": "workspace:*",
    "@zotlit/shared": "workspace:*",
    "@zotlit/templates": "workspace:*",
    "@zotlit/zotero-types": "workspace:*",
    "arkregex": "catalog:",
    "clsx": "^2.1.1",
    "eta": "catalog:",
    "fflate": "catalog:",
    "hono": "^4.12.31",
    "monkey-around": "catalog:",
    "nanoid": "^5.1.14",
    "p-limit": "^7.3.0",
    "preact": "^10.29.7",
    "react-textarea-autosize": "^8.5.9",
    "semver": "^7.8.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@electron/remote": "^2.1.3",
    "@logtape/logtape": "catalog:",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/vite": "catalog:",
    "@types/node-22": "npm:@types/node@^22.9.0",
    "@types/node-25": "npm:@types/node@^25.6.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "^7.7.1",
    "@types/turndown": "^5.0.6",
    "@zotlit/config": "workspace:*",
    "@zotlit/scripts": "workspace:*",
    "ajv": "catalog:",
    "electron": "^39.8.10",
    "happy-dom": "^20.9.0",
    "obsidian": "workspace:*",
    "oxlint": "catalog:",
    "pandoc-wasm": "^1.1.0",
    "tailwindcss": "catalog:",
    "turndown": "7.2.0",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "^1.3.8",
    "vitest": "catalog:"
  },
  "authorUrl": "https://github.com/aidenlx",
  "obsidian": {
    "id": "zotlit",
    "name": "ZotLit",
    "minAppVersion": "1.13.4",
    "minElectronVersion": "43.0.0",
    "isDesktopOnly": true,
    "fundingUrl": {
      "GitHub Sponsor": "https://github.com/sponsors/aidenlx"
    }
  }
}
