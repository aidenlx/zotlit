{
  "name": "@zotlit/obsidian",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Plugin to integrate with Zotero, create literature notes and insert citations from a Zotero library.",
  "author": "AidenLx",
  "type": "module",
  "scripts": {
    "build": "vite build && npm run typecheck",
    "build:dev": "vite build --mode development",
    "paraglide:compile": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide",
    "dev": "vite build --watch --mode development",
    "analyze": "ANALYZE=true vite build",
    "typecheck": "tsgo --noEmit -p tsconfig.app.json",
    "typecheck:test": "tsgo --noEmit -p tsconfig.test.json",
    "lint": "oxlint",
    "test": "tsgo --noEmit -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "@std/ini": "jsr:0.225.2",
    "@zotlit/db": "workspace:*",
    "@zotlit/item-lookup": "workspace:*",
    "@zotlit/shared": "workspace:*",
    "arkregex": "catalog:",
    "clsx": "^2.1.1",
    "eta": "^4.6.0",
    "fflate": "^0.8.2",
    "jotai": "^2.10.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-textarea-autosize": "^8.5.9",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@electron/remote": "^2.1.3",
    "@inlang/paraglide-js": "catalog:",
    "@logtape/logtape": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node-22": "npm:@types/node@^22.9.0",
    "@types/node-25": "npm:@types/node@^25.6.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/turndown": "^5.0.6",
    "@typescript/native-preview": "catalog:",
    "@zotlit/config": "workspace:*",
    "electron": "^39.8.10",
    "happy-dom": "^20.9.0",
    "obsidian": "workspace:*",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "turndown": "7.2.0",
    "valibot": "^1.0.0",
    "vite": "catalog:",
    "vite-bundle-analyzer": "^1.3.8",
    "vitest": "catalog:"
  },
  "authorUrl": "https://github.com/aidenlx",
  "obsidian": {
    "id": "zotlit",
    "name": "ZotLit",
    "minAppVersion": "1.13.1",
    "isDesktopOnly": true,
    "fundingUrl": {
      "GitHub Sponsor": "https://github.com/sponsors/aidenlx"
    }
  }
}
