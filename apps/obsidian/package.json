{
  "name": "@zotlit/obsidian",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Plugin to integrate with Zotero, create literature notes and insert citations from a Zotero library.",
  "author": "AidenLx",
  "type": "module",
  "scripts": {
    "build": "vite build && npm run typecheck",
    "build:dev": "vite build --mode development",
    "dev": "vite build --watch --mode development",
    "typecheck": "tsgo --noEmit -p tsconfig.app.json",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@types/node-22": "npm:@types/node@^22.9.0",
    "@types/node-25": "npm:@types/node@^25.6.2",
    "@typescript/native-preview": "catalog:",
    "@zotlit/config": "workspace:*",
    "obsidian": "^1.11.4",
    "oxlint": "catalog:",
    "valibot": "^1.0.0",
    "vite": "^8.0.0"
  },
  "authorUrl": "https://github.com/aidenlx",
  "obsidian": {
    "id": "zotlit",
    "name": "ZotLit",
    "minAppVersion": "1.12.7",
    "isDesktopOnly": true,
    "fundingUrl": {
      "GitHub Sponsor": "https://github.com/sponsors/aidenlx"
    }
  }
}
