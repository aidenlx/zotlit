{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.obsidian"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedDeclarations": false,
    "types": ["node-22"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": [
    "./node_modules",
    "./dist",
    "./dist-dev",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx"
  ]
}
