{
  "extends": ["@zotlit/config/tsconfig", "@zotlit/config/tsconfig.chrome142"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "isolatedDeclarations": false,
    "types": ["node-22"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*.ts", "./src/paraglide/**/*.js"],
  "exclude": ["./node_modules", "./dist", "./dist-dev", "./src/**/*.test.ts"]
}
