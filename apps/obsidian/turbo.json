{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "paraglide:compile": {
      "inputs": [
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ],
      "outputs": ["src/paraglide/**"],
      "outputLogs": "errors-only"
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "paraglide:compile"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "paraglide:compile"]
    }
  }
}
