{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate:language-packs": {
      "dependsOn": ["@zotlit/obsidian-i18n#build"],
      "inputs": [
        "scripts/generate-language-packs.ts",
        "scripts/language-pack-options.ts",
        "$TURBO_ROOT$/packages/obsidian-i18n/src/**",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**"
      ],
      "outputs": ["src/lib/i18n/generated/**"],
      "outputLogs": "errors-only"
    },
    "build": {
      "env": [
        "$TURBO_EXTENDS$",
        "ANALYZE",
        "ANNOTATION_SUGGESTER_ENABLED",
        "MIN_APP_VERSION",
        "WEB_WORKBENCH_ENABLED"
      ],
      "outputs": ["$TURBO_EXTENDS$", "bundle-stats.html"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**",
        "$TURBO_ROOT$/assets/logo/**"
      ]
    },
    "build:dev": {
      "cache": false,
      "env": [
        "ANALYZE",
        "ANNOTATION_SUGGESTER_ENABLED",
        "DOCS_SITE_URL",
        "I18N_DEV_SERVER",
        "MIN_APP_VERSION",
        "WEB_WORKBENCH_ENABLED",
        "ZT_VAULT_CASE"
      ],
      "outputs": ["$TURBO_EXTENDS$", "bundle-stats.html"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/settings.json",
        "$TURBO_ROOT$/messages/**",
        "$TURBO_ROOT$/assets/logo/**"
      ]
    },
    "dev": {
      "env": [
        "ANALYZE",
        "ANNOTATION_SUGGESTER_ENABLED",
        "DOCS_SITE_URL",
        "I18N_DEV_SERVER",
        "MIN_APP_VERSION",
        "WEB_WORKBENCH_ENABLED",
        "ZT_VAULT_CASE"
      ]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate:language-packs"]
    },
    "typecheck:test": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate:language-packs"]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "generate:language-packs"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/logo/**"]
    }
  }
}
