{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["AI_AGENT"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "build:dev": {
      "dependsOn": ["^build"],
      "outputs": ["dist-dev/**"],
      "outputLogs": "errors-only",
      "passThroughEnv": ["ZT_VAULT_CASE"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ZT_VAULT_CASE"]
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"]
    },
    "typecheck:test": {
      "dependsOn": ["^build", "transit"]
    },
    "test": {
      "dependsOn": ["^build", "transit"]
    },
    "fixture": {
      "dependsOn": [
        "^build",
        "@zotlit/obsidian#build:dev",
        "@zotlit/zotero#build:dev"
      ],
      "cache": false,
      "passThroughEnv": ["ZT_HOST_VAULT", "ZOTERO_APP"]
    },
    "e2e": {
      "dependsOn": [
        "^build",
        "@zotlit/obsidian#build:dev",
        "@zotlit/zotero#build:dev"
      ],
      "cache": false
    },
    "//#lint:repo:deps": {
      "dependsOn": [
        "@zotlit/db#build",
        "@zotlit/filter-expression#build",
        "@zotlit/item-lookup#build",
        "@zotlit/obsidian#generate:language-packs",
        "@zotlit/protocol#build",
        "@zotlit/shared#build",
        "@zotlit/templates#build",
        "@zotlit/workbench#build",
        "@zotlit/zotero-types#build",
        "@zotlit/docs#codegen",
        "@zotlit/docs#generate:i18n",
        "@zotlit/docs#cf-typegen:check"
      ]
    },
    "//#lint:repo": {
      "dependsOn": ["//#lint:repo:deps"]
    },
    "//#review:plugin:deps": {
      "dependsOn": [
        "@zotlit/db#build",
        "@zotlit/filter-expression#build",
        "@zotlit/item-lookup#build",
        "@zotlit/obsidian#generate:language-packs",
        "@zotlit/protocol#build",
        "@zotlit/shared#build",
        "@zotlit/templates#build",
        "@zotlit/workbench#build",
        "@zotlit/zotero-types#build"
      ]
    },
    "//#review:plugin": {
      "dependsOn": ["//#review:plugin:deps"],
      "inputs": [
        "eslint.config.js",
        "manifest.json",
        "apps/obsidian/src/**",
        "apps/obsidian/package.json",
        "apps/obsidian/tsconfig*.json"
      ]
    }
  }
}
