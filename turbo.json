{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "build:dev": {
      "dependsOn": ["^build"],
      "outputs": ["dist-dev/**"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"]
    },
    "typecheck:test": {
      "dependsOn": ["^build", "transit"]
    },
    "test": {
      "dependsOn": ["^build", "transit"]
    },
    "fixture": {
      "dependsOn": [
        "^build",
        "@zotlit/obsidian#build:dev",
        "@zotlit/zotero#build:dev"
      ],
      "cache": false
    },
    "//#lint:repo:deps": {
      "dependsOn": [
        "@zotlit/db#build",
        "@zotlit/item-lookup#build",
        "@zotlit/obsidian#generate:language-packs",
        "@zotlit/protocol#build",
        "@zotlit/shared#build",
        "@zotlit/templates#build",
        "@zotlit/zotero-types#build",
        "@zotlit/docs#codegen"
      ]
    },
    "//#lint:repo": {
      "dependsOn": ["//#lint:repo:deps"]
    },
    "//#review:plugin:deps": {
      "dependsOn": [
        "@zotlit/db#build",
        "@zotlit/item-lookup#build",
        "@zotlit/obsidian#generate:language-packs",
        "@zotlit/protocol#build",
        "@zotlit/shared#build",
        "@zotlit/templates#build",
        "@zotlit/zotero-types#build"
      ]
    },
    "//#review:plugin": {
      "dependsOn": ["//#review:plugin:deps"],
      "inputs": [
        "eslint.config.js",
        "manifest.json",
        "apps/obsidian/src/**",
        "apps/obsidian/package.json",
        "apps/obsidian/tsconfig*.json"
      ]
    }
  }
}
