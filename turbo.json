{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["AI_AGENT"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only",
      "env": ["DOCS_SITE_URL"]
    },
    "build:dev": {
      "dependsOn": ["^build"],
      "outputs": ["dist-dev/**"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"]
    },
    "typecheck:test": {
      "dependsOn": ["^build", "transit"]
    },
    "test": {
      "dependsOn": ["^build", "transit"],
      "env": ["GITHUB_ACTIONS"]
    },
    "fixture": {
      "dependsOn": [
        "^build",
        "@zotlit/obsidian#build:dev",
        "@zotlit/zotero#build:dev"
      ],
      "cache": false,
      "passThroughEnv": ["ZT_HOST_VAULT", "ZOTERO_APP", "ZT_VAULT_CASE"]
    },
    "e2e": {
      "dependsOn": [
        "^build",
        "@zotlit/obsidian#build:dev",
        "@zotlit/zotero#build:dev"
      ],
      "cache": false
    },
    "lint:deps": {
      "dependsOn": ["^build"]
    },
    "//#lint:repo:deps": {
      "dependsOn": [
        "^lint:deps",
        "@zotlit/obsidian#generate:language-packs",
        "@zotlit/docs#generate:messages",
        "@zotlit/docs#cf-typegen:check"
      ]
    },
    "//#lint:repo": {
      "dependsOn": ["//#lint:repo:deps"]
    },
    "//#review:plugin:deps": {
      "dependsOn": [
        "@zotlit/obsidian#lint:deps",
        "@zotlit/obsidian#generate:language-packs"
      ]
    },
    "//#review:plugin": {
      "dependsOn": ["//#review:plugin:deps"],
      "inputs": [
        "eslint.config.js",
        "manifest.json",
        "apps/obsidian/src/**",
        "apps/obsidian/package.json",
        "apps/obsidian/tsconfig*.json"
      ]
    }
  }
}
