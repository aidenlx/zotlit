{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build", "transit"]
    },
    "typecheck:test": {
      "dependsOn": ["^build", "transit"]
    },
    "test": {
      "dependsOn": ["^build", "transit"]
    },
    "//#lint:repo:deps": {
      "dependsOn": [
        "@zotlit/db#build",
        "@zotlit/item-lookup#build",
        "@zotlit/obsidian#paraglide:compile",
        "@zotlit/protocol#build",
        "@zotlit/shared#build",
        "@zotlit/templates#build",
        "@zotlit/zotero-types#build"
      ]
    },
    "//#lint:repo": {
      "dependsOn": ["//#lint:repo:deps"],
      "inputs": [
        "**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
        ".oxlintrc.json",
        "**/.oxlintrc.json",
        "packages/config/oxlint.base.json",
        "tsconfig*.json",
        "**/tsconfig*.json"
      ]
    },
    "//#format": {
      "inputs": [
        "**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,md,mdx,yml,yaml,html,css,scss}",
        ".oxfmtrc.json",
        "**/.oxfmtrc.json"
      ]
    }
  }
}
